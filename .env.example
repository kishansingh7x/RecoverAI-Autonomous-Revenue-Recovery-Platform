# ==============================================================================
# RecoverAI — Environment Configuration Template (.env.example)
# Razorpay AI Buildathon 2026 | Track 03: AI Revenue Recovery
# ==============================================================================
# NOTE: All LLM integrations are OPTIONAL. If no API key is provided,
# RecoverAI operates with 100% reliability using its deterministic rule engine,
# deterministic decision matrix, and curated fintech message templates.
# ==============================================================================

# Optional: Groq Cloud API Key (recommended for ultra-fast Llama-3 / Qwen inference)
# Format: gsk_...
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq Model Name (default: qwen/qwen3.8-27b or llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: xAI Grok API Key
# Format: xai-...
# GROK_API_KEY=your_xai_grok_api_key_here
# GROK_MODEL=grok-beta

# Optional: Anthropic Claude API Key
# Format: sk-ant-...
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
